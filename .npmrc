# Triage note: every setting below is a build/layout
# knob. This file has never held a credential and must not: registry auth tokens
# belong in the user-level ~/.npmrc or the CI secret store.
# test/security/npmrc-hygiene.security.test.js fails the build if a credential
# key or a strict-ssl downgrade lands here.

# vite-plugin-node-polyfills injects imports of `vite-plugin-node-polyfills/shims/*`
# into bundled code that lives in transitive packages (e.g. core's kdf.js when
# bundled by the web shell). Under pnpm's strict layout those imports can't be
# resolved from the transitive location. Flat-hoist so every bundled file can
# resolve every published shim. Trade-off: less isolation than pnpm's default.
shamefully-hoist=true

# The dev tree is NFS-shared with a Linux dev host (linux-arm64), where the CI
# gate runs the same node_modules the Mac (darwin-arm64) installed. Fetch native
# binaries for both platforms so sharp et al. load on either host.
#
# Every target is now listed rather than only the extras, because the same
# list lives in pnpm-workspace.yaml where pnpm 11 reads it as EXHAUSTIVE
# rather than additive (see the note there: an amd64 container installed no
# x64 binaries and the reproduce build died). Here, under pnpm 9 semantics,
# the extra entries are a superset of what this file used to request and
# change nothing about which host can run these node_modules.
supportedArchitectures.os[]=darwin
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=win32
supportedArchitectures.cpu[]=arm64
supportedArchitectures.cpu[]=x64

# Pin certificate verification ON at project level so no user-level ~/.npmrc can
# downgrade registry fetches for this repo (the sibling explorer repo had exactly
# that downgrade sitting in it unnoticed).
strict-ssl=true
