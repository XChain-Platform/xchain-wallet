# vite-plugin-node-polyfills injects imports of `vite-plugin-node-polyfills/shims/*`
# into bundled code that lives in transitive packages (e.g. core's kdf.js when
# bundled by the web shell). Under pnpm's strict layout those imports can't be
# resolved from the transitive location. Flat-hoist so every bundled file can
# resolve every published shim. Trade-off: less isolation than pnpm's default.
shamefully-hoist=true

# The dev tree is NFS-shared with devhost (linux-arm64), where the CI gate
# runs the same node_modules the Mac (darwin-arm64) installed. Fetch native
# binaries for both platforms so sharp et al. load on either host.
supportedArchitectures.os[]=darwin
supportedArchitectures.os[]=linux
supportedArchitectures.cpu[]=arm64
