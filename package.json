{
    "name": "xchain-wallet",
    "description": "Self-custodial multi-chain wallet for the XChain Platform (browser, Chrome extension, and desktop)",
    "version": "0.341.4",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/XChain-Platform/xchain-wallet.git"
    },
    "homepage": "https://dankest.llc",
    "author": "Dankest, LLC",
    "packageManager": "pnpm@11.8.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "typecheck": "pnpm -r --if-present typecheck",
        "lint": "pnpm -r --if-present lint",
        "build": "pnpm -r --if-present build",
        "ci": "pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:fuzz && pnpm test:smoke && pnpm test:tools",
        "ci:full": "bash bin/ci-full.sh",
        "test": "pnpm test:unit && pnpm test:fuzz && pnpm test:smoke && pnpm test:tools",
        "test:unit": "vitest run --config test/vitest/unit.config.js",
        "test:unit:watch": "vitest --config test/vitest/unit.config.js",
        "test:unit:coverage": "vitest run --config test/vitest/unit.config.js --coverage",
        "test:smoke": "node test/smoke/_run-smokes.js",
        "test:tools": "node --test \"tools/**/*.test.mjs\"",
        "test:integration": "vitest run --config test/vitest/integration.config.js",
        "test:integration:watch": "vitest --config test/vitest/integration.config.js",
        "test:integration:regtest": "bash tools/regtest/test-integration.sh",
        "test:boundary": "vitest run --config test/vitest/boundary.config.js",
        "test:chaos": "vitest run --config test/vitest/chaos.config.js",
        "test:fuzz": "vitest run --config test/vitest/fuzz.config.js",
        "test:regression": "vitest run --config test/vitest/regression.config.js",
        "test:security": "vitest run --config test/vitest/security.config.js",
        "test:bench": "node test/benchmarks/harness.js",
        "test:bench:quick": "node test/benchmarks/harness.js --quick",
        "test:mutation": "stryker run test/mutation/stryker.config.mjs",
        "test:a11y": "vitest run --config test/vitest/a11y.config.js",
        "test:hardware:ledger": "node test/hardware/ledger-speculos.js",
        "test:e2e": "playwright test --config test/e2e/playwright.config.js",
        "test:e2e:headed": "playwright test --config test/e2e/playwright.config.js --headed",
        "test:e2e:regtest": "playwright test --config test/e2e/playwright.regtest.config.js",
        "test:e2e:testnet": "playwright test --config test/e2e/playwright.testnet.config.js",
        "test:all": "pnpm test:unit && pnpm test:smoke && pnpm test:integration && pnpm test:boundary && pnpm test:chaos && pnpm test:fuzz && pnpm test:regression && pnpm test:security && pnpm test:a11y && pnpm test:tools",
        "release:gate": "pnpm run ci && pnpm run test:e2e:regtest",
        "release:sign": "bash tools/release/sign.sh --tag v$(node -p \"require('./package.json').version\") --input release-artifacts/v$(node -p \"require('./package.json').version\")",
        "release:verify": "bash tools/release/verify.sh --tag v$(node -p \"require('./package.json').version\") --input release-artifacts/v$(node -p \"require('./package.json').version\")",
        "release:verify-controls": "node tools/release/verify-ci-controls.mjs",
        "visual:compare": "node scripts/visual-compare.mjs",
        "visual:clean": "node scripts/visual-clean.mjs",
        "sdk:check": "node tools/dev/sdk-installed-guard.mjs",
        "sdk:link": "node tools/dev/sdk-link.mjs link",
        "sdk:unlink": "node tools/dev/sdk-link.mjs unlink",
        "sdk:status": "node tools/dev/sdk-link.mjs status"
    },
    "pnpm": {
        "minimumReleaseAgeExclude": [
            "@dankest-llc/*"
        ]
    },
    "devDependencies": {
        "@babel/parser": "^7.29.2",
        "@babel/traverse": "^7.29.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.5.0",
        "@testing-library/react": "^16.0.1",
        "@vitejs/plugin-react": "^4.3.0",
        "@vitest/coverage-v8": "^4.1.11",
        "axe-core": "^4.10.0",
        "fast-check": "^4.6.0",
        "jsdom": "^25.0.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "vitest": "^4.1.11"
    }
}
