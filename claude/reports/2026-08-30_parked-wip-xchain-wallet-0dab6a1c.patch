+
+// The messaging flows must name the funding address and the change sink
+// themselves. Neither used to, and it only showed on the handshake: a send
+// goes through the confirm pipeline, where composeForConfirm supplies the
+// pair and hands back a prebuilt PSBT, so the encoder never saw the send's
+// own encoderOpts. The handshake is called directly and built live, so the
+// encoder refused it ("Transaction would burn significant satoshis as fees.
+// Please provide a change address.") and first contact with an address the
+// chain had never seen was impossible. `submitAction` only rotates a change
+// address that is already there; it never supplies one, so this is the only
+// layer that can.
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+vi.mock('../../../packages/core/src/flows/submitAction.js', () => ({
+    submitAction: vi.fn(async () => ({ txid: 'msg-tx-1' })),
+}));
+
+import { submitAction } from '../../../packages/core/src/flows/submitAction.js';
+import { handshakeAction, messageAction } from '../../../packages/core/src/flows/messageAction.js';
+
+const FROM = 'bcrt1qfromaddr00000000000000000000000000000000';
+const DESTINATION = 'bcrt1qdestaddr000000000000000000000000000000';
+const DESCRIPTOR = { coin: 'bitcoin', addressTypes: ['p2wpkh', 'p2pkh'] };
+
+function baseOpts(extra = {}) {
+    return {
+        vault: {},
+        walletId: 'w1',
+        password: 'pw',
+        chainRegistry: { get: () => DESCRIPTOR },
+        sdkRegistry: { get: () => ({}) },
+        chainId: 'bitcoin-regtest',
+        from: {
+            address: FROM,
+            publicKey: '02' + 'cd'.repeat(32),
+            derivationPath: "m/84'/1'/0'/0/0",
+        },
+        destination: DESTINATION,
+        ...extra,
+    };
+}
+
+function submittedEncoderOpts() {
+    expect(submitAction).toHaveBeenCalledTimes(1);
+    return vi.mocked(submitAction).mock.calls[0][0].encoderOpts;
+}
+
+describe('messaging flows supply a change address (XC-1820)', () => {
+    beforeEach(() => {
+        vi.mocked(submitAction).mockClear();
+    });
+
+    it('handshakeAction funds from the source and returns change to it', async () => {
+        await handshakeAction(baseOpts({ version: 0 }));
+        const encoderOpts = submittedEncoderOpts();
+        expect(encoderOpts.sourceAddress).toBe(FROM);
+        expect(encoderOpts.change).toBe(FROM);
+        expect(encoderOpts.pubkey).toBe('02' + 'cd'.repeat(32));
+    });
+
+    it('handshakeAction keeps change equal to sourceAddress so submitAction can rotate it', async () => {
+        // submitAction rotates only the self-change default (change ===
+        // sourceAddress); a handshake has no reason to point change elsewhere.
+        await handshakeAction(baseOpts({ version: 1 }));
+        const encoderOpts = submittedEncoderOpts();
+        expect(encoderOpts.change).toBe(encoderOpts.sourceAddress);
+    });
+
+    it('a plaintext messageAction built live carries the same pair', async () => {
+        await messageAction(baseOpts({ message: 'hello', method: null }));
+        const encoderOpts = submittedEncoderOpts();
+        expect(encoderOpts.sourceAddress).toBe(FROM);
+        expect(encoderOpts.change).toBe(FROM);
+        expect(vi.mocked(submitAction).mock.calls[0][0].prebuiltPsbt).toBeUndefined();
+    });
+
+    it('a prebuilt-PSBT messageAction still passes the pair, and the PSBT it must sign byte-identically', async () => {
+        await messageAction(baseOpts({
+            prebuiltParams: { VERSION: '3', COIN: 'BTC', DESTINATION, PLAINTEXT_MESSAGE: 'hi' },
+            prebuiltPsbt: 'cHNidP8BAA==',
+        }));
+        const call = vi.mocked(submitAction).mock.calls[0][0];
+        expect(call.prebuiltPsbt).toBe('cHNidP8BAA==');
+        expect(call.encoderOpts.change).toBe(FROM);
+        expect(call.encoderOpts.sourceAddress).toBe(FROM);
+    });
+});
