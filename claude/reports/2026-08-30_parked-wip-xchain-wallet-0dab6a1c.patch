+/**
+ * Reads a `/api/feequote` body and says whether it is a VERDICT, a body worth
+ * asking again for, or something that must never be handed to a spec as a
+ * quote.
+ *
+ * The distinction this draws is the one that cost tokens/ticker-grammar four
+ * driven runs of wrong conclusions (XC-1786/XC-1787). A verdict is a body whose
+ * `status` is a string: `valid`, or `invalid: <named reason>`. The venue never
+ * answers a refusal without naming it, so a body with NO `status` is not the
+ * chain refusing anything; it is the explorer or the indexer failing to answer
+ * (a rate limit, an upstream timeout, a busy quote engine, an indexer that is
+ * not ready) or the quote path dying before the dry-run produced a verdict. A
+ * caller that does `String(quote.status)` on such a body reads the literal
+ * "undefined", compares it against 'valid', and records a refusal the chain
+ * never gave.
+ *
+ * Three kinds come out:
+ *   - `verdict`:    `status` is a string; `status` is carried on the result.
+ *   - `retry`:      the venue is still working (busy) or the hop blipped
+ *                   (UPSTREAM_ERROR, RATE_LIMITED, no body); ask again.
+ *   - `unreadable`: a body that is neither, which the caller must FAIL on,
+ *                   naming what came back, rather than return as a quote.
+ *
+ * `priceLapsed` flags the one unreadable body whose remedy is known: an error
+ * naming a missing or stale oracle price, which a re-seed repairs.
+ *
+ * @param {any} body the parsed `/api/feequote` response, or null on transport failure
+ * @returns {{ kind: 'verdict', status: string }
+ *         | { kind: 'retry', reason: string }
+ *         | { kind: 'unreadable', reason: string, priceLapsed: boolean }}
+ */
+export function readQuote(body) {
+    if (!body || typeof body !== 'object') {
+        return { kind: 'retry', reason: 'the explorer returned no fee quote at all' };
+    }
+    if (typeof body.status === 'string') {
+        return { kind: 'verdict', status: body.status };
+    }
+    if (body.busy === true || body.code === 'UPSTREAM_ERROR' || body.code === 'RATE_LIMITED') {
+        return { kind: 'retry', reason: body.error || body.code || 'the venue is still working' };
+    }
+    const error = typeof body.error === 'string' ? body.error : '';
+    return {
+        kind: 'unreadable',
+        reason: error || (body.code ? `the explorer answered ${body.code}` : 'the venue returned no verdict'),
+        priceLapsed: /no current oracle price|stale beyond/i.test(error),
+    };
+}
+
+/**
+ * The message a spec's operator should get when `/api/feequote` gave no
+ * verdict, even after the venue price was re-seeded and the question re-asked.
+ *
+ * Its whole job is to make sure the failure reads as VENUE state and names
+ * the price, so that the next reader does not write "the venue refuses this
+ * class" into a spec header. Everything that was learned along the way rides
+ * on it: what the explorer answered both times, and what the re-seed found.
+ *
+ * @param {{ action: string, params?: string, first: object, retry: object,
+ *           reseed: object|null, reseedError?: string|null }} args
+ */
+export function noVerdictMessage({ action, params, first, retry, reseed, reseedError = null }) {
+    const lines = [
+        `/api/feequote returned NO VERDICT for ${action}${params !== undefined ? ` (${params})` : ''}: `
+            + `${retry.reason}.`,
+        '',
+        'This is NOT a refusal and must never be recorded as one. A genuine refusal',
+        'always carries a named reason in `status` (`invalid: TICK (length)`,',
+        '`invalid: issued by another address`); a body with no `status` is the venue',
+        'failing to answer, and the usual cause is the seeded venue price having lapsed',
+        `mid-run: it lives ${ORACLE_MAX_PRICE_AGE_SECONDS}s of CHAIN time and every driven`,
+        'action mines blocks that burn it. The tell is which steps fail: early ones pass',
+        'and late ones "get refused", which is a clock, not a rule.',
+    ];
+    if (retry.priceLapsed || first.priceLapsed) {
+        lines.push('', 'The body names the price itself, so this IS that case.');
+    }
+    if (reseedError) {
+        lines.push('', `Re-seeding the price was attempted and FAILED: ${reseedError}`);
+    } else if (reseed) {
+        const margin = Number.isFinite(reseed.marginSeconds) ? `${reseed.marginSeconds}s of chain life left` : 'margin unknown';
+        lines.push('', `Re-seed result: ${reseed.seeded ? 'wrote a fresh price' : `did not write (${reseed.reason})`}, ${margin}.`);
+    }
+    lines.push('', `First body: ${JSON.stringify(first.body)}`, `Body after re-seed: ${JSON.stringify(retry.body)}`);
+    return lines.join('\n');
+}
