{
    "manifest_version": 3,
    "name": "XChain Wallet",
    "version": "0.1.0",
    "description": "Self-custodial multi-chain wallet for the XChain Platform",
    "action": {
        "default_title": "XChain Wallet"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content/contentScript.js"],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["inject/xchainProvider.js"],
            "matches": ["http://*/*", "https://*/*"]
        }
    ],
    "permissions": ["storage"],
    "host_permissions": []
}
