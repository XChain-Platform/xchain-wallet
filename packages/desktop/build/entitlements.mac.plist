<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    macOS hardened-runtime entitlements — §40.12 Step 19.
    Keep this file as narrow as possible; each entitlement widens the
    attack surface. Notarization will reject anything unused.

    - com.apple.security.cs.allow-unsigned-executable-memory: false
      (default). We don't JIT any code.
    - com.apple.security.cs.allow-jit: false. Same.
    - com.apple.security.device.usb: required for WebHID on macOS —
      @ledgerhq/hw-transport-webhid opens the Ledger HID interface via
      IOKit, which the hardened runtime gates behind this entitlement.
      Same mechanism Trezor Bridge uses when its own HID handoff fires.
    - com.apple.security.network.client: required for xchain-sdk calls
      (REST/JSON-RPC to xchain-explorer / xchain-encoder) + electron-updater
      update manifest fetches + Trezor Connect iframe loading
      connect.trezor.io.
    - com.apple.security.files.user-selected.read-write: NOT currently
      needed — we use app.getPath('userData') for all storage. If we
      add an "export PSBT" feature that writes to a user-chosen path,
      revisit.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.device.usb</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
