{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "maxItems": 20,
    "items": {
        "type": "object",
        "required": ["id", "family", "kind", "title", "body", "at", "read"],
        "additionalProperties": false,
        "properties": {
            "id": { "type": "string" },
            "family": {
                "type": "string",
                "enum": [
                    "txConfirmations", "incomingReceipts", "incomingPending", "messages",
                    "governancePolls", "deadlines", "dispenserEscrow", "dispenserFills",
                    "orderFills", "priceAlerts", "request", "paydue"
                ]
            },
            "kind": { "type": "string" },
            "title": { "type": "string", "maxLength": 60 },
            "body": { "type": "string", "maxLength": 160 },
            "at": { "type": "number", "minimum": 0 },
            "read": { "type": "boolean" }
        }
    }
}
