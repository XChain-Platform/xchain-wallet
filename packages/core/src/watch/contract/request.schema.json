{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["id", "kind", "iconHash", "sentence", "amountText"],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{32}$"
        },
        "kind": {
            "enum": ["request", "paydue"]
        },
        "iconHash": { "type": "string" },
        "sentence": {
            "type": "string",
            "maxLength": 200
        },
        "amountText": { "type": "string" },
        "expiresAt": {
            "type": "integer",
            "minimum": 0
        }
    }
}
