{
    "appId": "io.xchain.wallet.android",
    "appName": "XChain Wallet",
    "webDir": "www",
    "android": {
        "allowMixedContent": false,
        "loggingBehavior": "none"
    },
    "server": {
        "androidScheme": "https",
        "allowNavigation": []
    },
    "plugins": {
        "SystemBars": {
            "insetsHandling": "css",
            "initialViewportFitValueHint": "cover",
            "style": "DEFAULT"
        }
    },
    "ios": {
        "contentInset": "never"
    }
}
