<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules (§1). Android 12 split the old
  fullBackupContent into two independent surfaces, and BOTH have to refuse:
  cloud-backup takes app data to Google's servers, device-transfer copies it
  to a new phone during setup.

  Everything is excluded, which is not caution for its own sake:

    - The vault blob is encrypted under a key that lives in this device's
      Keystore and cannot be exported. A copy on another device is
      undecryptable, so a "successful" restore would hand the user a wallet
      that opens to nothing and looks like data loss rather than a design.
    - Settings, contacts and connected sites are NOT encrypted, and they are
      a map of who the user transacts with. Shipping them to a cloud backup
      is a privacy leak with no upside, since the vault they belong to
      cannot come with them.

  New-device recovery is seed re-import, stated plainly in the listing and
  the docs. That is the honest self-custody answer, and it is the only one
  consistent with keys that never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
