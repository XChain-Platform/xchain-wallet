/node_modules
/packages/*/node_modules
/packages/*/dist
#  §7.5 rehearsal output. Listed separately because `/packages/*/dist`
# does NOT match `dist-staging`, and these are SIGNED binaries pointed at a
# non-public feed: exactly the thing not to commit by accident.
/packages/*/dist-staging
/packages/*/build
/packages/*/coverage
/packages/desktop/renderer/dist
# The Capacitor webDir: a verbatim copy of packages/web/dist staged by
# packages/mobile/scripts/build.js. Generated, and committing it would create a
# second copy of the SPA that could drift from the one the web shell ships.
/packages/mobile/www

# App Store listing screenshots  are TRACKED, and the rule that used
# to sit here is what let the store listing depict a build 18 shared-UI commits
# older than the binary Apple holds with nothing able to say so (,
#  frontier row 63). They stopped being build output the day they were
# uploaded: they are published collateral, and published collateral belongs in
# history like the Chrome and Mac App Store sets. The harness's own per-run
# xcodebuild log is still excluded, by the repo-wide *.log rule above.
# Playwright output dirs carry a per-run suffix (test-results-s40d and
# friends), so match the prefix rather than listing each one as it appears.
/test/e2e/test-results*/
/test/e2e/node_modules

# electron-builder buildResources dir - tracked (entitlements + icon
# metadata), not a build-output directory despite the name.
!/packages/desktop/build/
/.env
.DS_Store
*.log
.vscode/
.idea/

# Reproducible-build scratch. `.reproduce-home` is the container's HOME (the
# pnpm store and the electron cache), which reproduce.sh points inside the
# build tree so the run owns what it writes; `reproduce-out` is its default
# manifest directory. Both used to land only in a throwaway worktree; in-place
# mode  puts them in the checkout, which is where the release lane
# now builds.
/.reproduce-home/
/reproduce-out/

# Coverage output (c8/nyc) - generated, not source
coverage/
.nyc_output/
.claude/

# Playwright E2E artifacts (traces, videos, screenshots, HTML report)
test/e2e/test-results/
test/e2e/test-results-regtest/
test/e2e/test-results-extension/
test/e2e/playwright-report/

# Stryker mutation-testing output : sandbox copies and HTML report,
# both regenerated by `pnpm test:mutation`.
/.stryker-tmp/
/reports/

# Release artifacts staged for a store submission (Chrome ceremony Phase 4a).
# Multi-megabyte CI binaries: never committed. The runbook tells every release
# operator to stage them here, so without this line each one is a bare `git add`
# away from putting them in a shared repo that has an incident class for exactly that.
release-artifacts/

# The xchain-documentation sibling, when CI checks it out (, ci.yml).
# actions/checkout cannot write outside GITHUB_WORKSPACE, so on a runner the
# sibling lands INSIDE this repo and XCHAIN_DOCS_ROOT points the smokes at it.
# Ignored so a checkout that has to live in the tree can never be mistaken for
# a change to it, by a drift guard or by a person.
/.docs-sibling/

# Runtime state for the store-version monitor's Play absence latch
# . The monitor defaults its state file to beside itself, which
# is right on the monitor host (/opt/xchain) but means a run from inside
# a checkout drops an untracked file in tools/release/. Two coders share
# one index here, so an untracked stray is one `git add .` away from
# somebody else's commit.
/tools/release/store-monitor-state.json
